# =============================================================================
# custom.rules - Suricata Detection Rules for PFA
# =============================================================================
# --- RECONNAISSANCE ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA Nmap SYN scan detected"; flags:S; threshold:type both, track by_src, count 50, seconds 10; sid:1000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"PFA Port scan detected"; flags:S; threshold:type both, track by_src, count 100, seconds 10; sid:1000002; rev:1;)
# --- BRUTE FORCE ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 22 (msg:"PFA SSH brute force detected"; flags:S; threshold:type both, track by_src, count 15, seconds 30; sid:1000010; rev:1;)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA HTTP brute force detected"; content:"POST"; http_method; content:"login.php"; http_uri; threshold:type both, track by_src, count 30, seconds 30; sid:1000011; rev:1;)
# --- WEB ATTACKS ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA SQL injection attempt detected"; content:"'"; http_uri; content:"--"; http_uri; sid:1000020; rev:1;)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA SQL injection UNION detected"; content:"UNION"; http_uri; nocase; content:"SELECT"; http_uri; nocase; sid:1000021; rev:1;)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA Nikto web scanner detected"; content:"Nikto"; http_user_agent; sid:1000022; rev:1;)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA directory traversal detected"; content:"../"; http_uri; sid:1000023; rev:1;)
# --- WAF/SCANNER DETECTION ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA SQLMAP detected"; content:"sqlmap"; http_user_agent; nocase; sid:1000040; rev:1;)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA Acunetix scanner detected"; content:"Acunetix"; http_user_agent; nocase; sid:1000041; rev:1;)
# --- METASPLOIT ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA Metasploit exploit attempt"; content:"cmd="; http_uri; content:"/bin/sh"; http_uri; sid:1000050; rev:1;)
alert tcp $HTTP_SERVERS 80 -> $EXTERNAL_NET any (msg:"PFA Reverse shell callback detected"; sid:1000051; rev:1;)
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA Metasploit PHP payload detected"; content:"<?php"; http_client_body; sid:1000052; rev:1;)
# --- DOS ATTACKS ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS 80 (msg:"PFA TCP SYN flood detected"; flags:S; threshold:type both, track by_src, count 500, seconds 5; sid:1000060; rev:1;)
alert icmp $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"PFA ICMP flood detected"; threshold:type both, track by_src, count 100, seconds 5; sid:1000061; rev:1;)
# --- MALICIOUS TRAFFIC ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"PFA Known malicious IP traffic"; sid:1000070; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"PFA Potential reverse shell to port 4444"; sid:1000071; rev:1;)
# --- POLICY VIOLATIONS ---
alert tcp $HOME_NET any -> $SQL_SERVERS 5432 (msg:"PFA Unauthorized DB access attempt"; sid:1000080; rev:1;)
alert ip $HOME_NET any -> $HOME_NET any (msg:"PFA Possible network scanning internal"; threshold:type both, track by_src, count 200, seconds 30; sid:1000081; rev:1;)